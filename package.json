{
  "type": "module",
  "devDependencies": {
    "@bazel/buildifier": "^6.4.0",
    "@sxproto/sxpb": "github:sxproto/sxpb-js#45e5fc037c1334450c0d6e47ae8e47ff6d18399c",
    "@types/node": "^22.10.6",
    "eslint": "^9.35.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "buildifier:check": "buildifier -r -mode=check .",
    "buildifier:fix": "buildifier -r -mode=fix .",
    "build": "tsc",
    "eslint:check": "eslint . --quiet",
    "eslint:fix": "eslint . --quiet --fix",
    "lint:fix": "npm-run-all --parallel eslint:fix buildifier:fix",
    "lint": "npm-run-all --parallel eslint:check buildifier:check",
    "serve:demo": "node dist/src/server/main.js --http_path=/tryswap --demo_urlpath=demo",
    "test": "npm run build && npm run test:unit",
    "test:unit": "vitest run --reporter=dot",
    "test:browse": "playwright test --reporter=dot --trace=retain-on-failure test/webchat test/webdual test/webrtcchat",
    "tidy": "npm run lint:fix",
    "tidytest": "npm run tidy && npm run lint && npm test"
  }
}
