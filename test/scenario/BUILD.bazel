load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@fildesh//tool/bazel:fildesh_run.bzl", "fildesh_run")
load("scenario.bzl", "rendezqueue_scenario_test")

bzl_library(
    name = "scenario_bzl",
    srcs = ["scenario.bzl"],
)

proto_library(
    name = "scenario_proto",
    testonly = True,
    srcs = ["scenario.proto"],
    deps = ["//proto:rendezqueue_proto"],
)

fildesh_run(
    name = "package_json",
    testonly = True,
    output_by_xof = {"o": "package.json"},
    src_content = """
|< splice -- / "(type module)" /
|- sxpb2json
|> splice -o $(XOF o)
""",
)

rendezqueue_scenario_test(name = "basic")

rendezqueue_scenario_test(name = "webchat")
